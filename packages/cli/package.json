{
  "name": "@tangen/cli",
  "version": "0.2.1",
  "description": "Tangen CLI — push schemas, scaffold workspaces, generate types",
  "homepage": "https://github.com/raghunathj/tangen#readme",
  "bugs": { "url": "https://github.com/raghunathj/tangen/issues" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raghunathj/tangen.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "tangen": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/__tests__/**",
    "!src/**/*.test.ts",
    "skills",
    "bin",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./src/index.ts",
    "bin": {
      "tangen": "./bin/tangen.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist --target bun --format esm --packages external",
    "test": "bun test"
  },
  "dependencies": {
    "@tangen/types": "workspace:^",
    "@tangen/schema": "workspace:^",
    "@tangen/db": "workspace:^",
    "drizzle-orm": "^0.45.2",
    "@paralleldrive/cuid2": "^2.2.2",
    "ioredis": "5.11.1",
    "@tangen/knowledge": "workspace:^"
  }
}
