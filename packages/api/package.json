{
  "name": "@tangen/api",
  "version": "0.1.215",
  "description": "The Tangen API server - createServer, the REST surface, and the runtime capability registry",
  "homepage": "https://github.com/raghunathj/tangen#readme",
  "bugs": { "url": "https://github.com/raghunathj/tangen/issues" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raghunathj/tangen.git",
    "directory": "packages/api"
  },
  "main": "./src/index.ts",
  "scripts": {
    "dev": "bun --env-file=../../.env run --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "start": "bun run dist/index.js",
    "test": "bun test"
  },
  "dependencies": {
    "@tangen/db": "workspace:^",
    "@tangen/graphql": "workspace:^",
    "@tangen/knowledge": "workspace:^",
    "@tangen/logging": "workspace:^",
    "@tangen/mcp": "workspace:^",
    "@tangen/porter": "workspace:^",
    "@tangen/schema": "workspace:^",
    "@tangen/studio-compiler": "workspace:^",
    "@tangen/studio-schema": "workspace:^",
    "@tangen/types": "workspace:^",
    "bullmq": "5.78.1",
    "drizzle-orm": "^0.45.2",
    "elysia": "1.4.28",
    "ioredis": "5.11.1",
    "jose": "^5.6.3",
    "nodemailer": "^9.0.1"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1"
  },
  "files": [
    "src",
    "!src/**/__tests__/**",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./src/index.ts",
    "exports": {
      ".": {
        "default": "./src/index.ts"
      }
    }
  },
  "optionalDependencies": {
    "sharp": "^0.35.1"
  },
  "exports": {
    ".": "./src/index.ts",
    "./lean": "./src/server-lean.ts",
    "./kernel": "./src/kernel/index.ts",
    "./package.json": "./package.json"
  }
}
