{
  "name": "@tangen/realtime-admin",
  "version": "0.1.3",
  "description": "Realtime for the Tangen admin, Studio and admin-facing extensions: per-environment clients over @tangen/realtime and the useRealtime React hook. Builds on the primitive; never a second transport.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raghunathj/tangenplatform.git",
    "directory": "packages/realtime-admin"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist --target browser --format esm --packages external && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@tangen/realtime": "workspace:^",
    "@tangen/realtime-react": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-test-renderer": "18.3.0",
    "react": "^18.3.1",
    "react-test-renderer": "18.3.1"
  }
}
