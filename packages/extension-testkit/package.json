{
  "name": "@tangen/extension-testkit",
  "version": "0.1.8",
  "description": "Test an extension against the real Tangen kernel: a ctx built from its grants, fake peers, contribution assertions.",
  "homepage": "https://github.com/raghunathj/tangen#readme",
  "bugs": { "url": "https://github.com/raghunathj/tangen/issues" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raghunathj/tangen.git",
    "directory": "packages/extension-testkit"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@tangen/api": "workspace:^",
    "@tangen/types": "workspace:^"
  },
  "files": [
    "src",
    "!**/__tests__/**",
    "!**/*.test.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./src/index.ts"
  }
}
