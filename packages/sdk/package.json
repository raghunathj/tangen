{
  "name": "@tangen/sdk",
  "version": "0.1.45",
  "description": "TypeScript SDK for querying content, globals, and search from a Tangen CMS API",
  "homepage": "https://github.com/raghunathj/tangen#readme",
  "bugs": { "url": "https://github.com/raghunathj/tangen/issues" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raghunathj/tangen.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node-ssr.d.ts",
        "import": "./dist/node-ssr.js",
        "default": "./dist/node-ssr.js"
      }
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/node-ssr.ts --outdir dist --target node --format esm --packages external --splitting && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "test": "bun test"
  },
  "dependencies": {
    "@tangen/types": "workspace:^"
  },
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node-ssr.ts",
    "./package.json": "./package.json"
  }
}
