{
  "name": "@tangen/studio-react",
  "version": "0.1.1",
  "description": "The Studio runtime for React sites - drop <StudioBlocks/> into any React app to server-render Tangen Studio pages: kit blocks, token-bound styling, data bindings and collection loops.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raghunathj/tangenplatform.git",
    "directory": "packages/studio-react"
  },
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.tsx",
    "./styles.css": "./src/styles.css"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@tangen/studio": "workspace:^",
    "@tangen/studio-runtime": "workspace:^",
    "@tangen/studio-schema": "workspace:^"
  }
}
