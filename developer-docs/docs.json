  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "redirects": [
    {
      "source": "/build/forms",
      "destination": "/extensions/forms"
    },
    {
      "source": "/build/forms/index",
      "destination": "/extensions/forms"
    },
    {
      "source": "/build/seo",
      "destination": "/extensions/seo"
    },
    {
      "source": "/build/seo/index",
      "destination": "/extensions/seo"
    },
    {
      "source": "/reference/environments",
      "destination": "/reference/deployments"
    },
    {
      "source": "/build/environments",
      "destination": "/build/deployments"
    },
    {
      "source": "/build/environments/index",
      "destination": "/build/deployments"
    },
    {
      "source": "/learn/enterprise-website/environments",
