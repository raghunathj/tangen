# Northwind Systems - environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── This deployment ────────────────────────────────────────────────────────────
# One database per deployment. A staging or production server has its own .env
# with its own DATABASE_URL and TANGEN_DEPLOYMENT_ROLE=staging|production.
DATABASE_URL=postgres://localhost:5432/northwind-systems_dev
# TANGEN_DEPLOYMENT_ROLE=development

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
ADMIN_PORT=3001
# SERVER_URL=http://localhost:3000
# ADMIN_URL=http://localhost:3001
# Your FRONT-END site (any framework) - used by live preview + CORS. Not the admin. :4321 default.
FRONTEND_URL=http://localhost:4321
# FRONTEND_PREVIEW_URL=http://localhost:4321/preview?id={id}&type={type}
# Required - min 32 chars: openssl rand -hex 32
JWT_SECRET=

# ── Redis (optional - background task queue, caching, locks) ──────────────────
# REDIS_URL=redis://localhost:6379

# ── Media storage (optional - docs/storage.md; default: local public/media) ───
# MEDIA_DIR=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Mail (optional - docs/mail.md) ─────────────────────────────────────────────
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
# SENDGRID_API_KEY=
# RESEND_API_KEY=

# ── Content AI provider keys (optional - docs/content-ai.md) ──────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
