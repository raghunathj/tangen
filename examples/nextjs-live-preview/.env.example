# The Tangen API base URL (no trailing /api/v1). Same value your tangen.config uses for server.url.
NEXT_PUBLIC_TANGEN_API_URL=http://localhost:3000

# A published-read API key (server-only) — create one in the admin under Settings → API Keys.
# For live preview it also needs the objects:read_draft grant if you want draft reads via the SDK.
TANGEN_API_KEY=

# The Tangen ADMIN origin, used to verify postMessage in live preview (Tier 2). Security-critical:
# only messages from this origin are trusted. Set it to wherever the admin actually runs —
# e.g. http://localhost:3001. A mismatch here is the usual cause of a stuck "No SDK" badge.
NEXT_PUBLIC_TANGEN_ADMIN_ORIGIN=http://localhost:3001

# The workspace and environment published pages are delivered from. These are
# public ROUTING identifiers, not credentials - but they are kept server-side
# so they never appear in page source, and so the browser reads delivery
# through this site's own /api/studio-delivery proxy.
TANGEN_WORKSPACE_ID=
TANGEN_ENV=
